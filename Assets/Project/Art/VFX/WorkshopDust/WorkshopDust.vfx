  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661614583}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots: []
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614619}
  m_BlockName: "Bloom \u2022 dissolve"
  m_HLSLCode: "void DustEvolution(inout VFXAttributes attributes)\n{\n float t=saturate(attributes.age/max(attributes.lifetime,0.01));\n
    float r=frac(sin((float)attributes.particleId*12.9898+3.19)*43758.5453);\n float
    grow=1.0-pow(1.0-saturate(t/0.45),3.0);\n attributes.size=(0.20+r*0.13)*(0.55+0.95*grow)*(1.0-0.30*smoothstep(0.60,1.0,t));\n
    attributes.alpha=0.92*smoothstep(0.0,0.04,t)*(1.0-smoothstep(0.65,1.0,t));\n
    attributes.color=lerp(lerp(float3(0.91,0.85,0.72),float3(0.85,0.78,0.64),r),float3(0.94,0.89,0.78),t*0.15);\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DustEvolution
    selectedIndex: 0
