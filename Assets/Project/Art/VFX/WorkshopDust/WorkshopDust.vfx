  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 8926484042661614700}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 8926484042661614728}
  - {fileID: 8926484042661614732}
  - {fileID: 8926484042661614736}
  - {fileID: 8926484042661614740}
  - {fileID: 8926484042661614741}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 8926484042661614727}
  m_BlockName: "Shape \u2022 direction \u2022 variation"
  m_HLSLCode: "void DustBirth(inout VFXAttributes attributes, in float3 BurstPosition,
    in float3 BurstDirection, in float3 GroundNormal, in float BurstStrength, in
    float IsBrake)\n{\n float r=frac(sin((float)attributes.particleId*12.9898+3.19)*43758.5453);\n
    float q=frac(sin((float)attributes.particleId*78.233+17.23)*21837.125);\n float
    a=q*6.2831853;\n float3 tangent=normalize(cross(GroundNormal,float3(0,0,1)));\n
    float3 bitangent=cross(GroundNormal,tangent);\n float3 radial=tangent*cos(a)+bitangent*sin(a);\n
    float3 wake=lerp(radial,-BurstDirection,IsBrake*0.75);\n attributes.position=BurstPosition+GroundNormal*0.022+radial*(0.05+q*0.16)*BurstStrength;\n
    attributes.velocity=wake*(0.34+r*0.38)*BurstStrength+GroundNormal*0.0;\n attributes.lifetime=0.22+q*0.10;\n
    attributes.age=0.0; attributes.mass=1.0;\n attributes.scaleX=BurstStrength; attributes.scaleY=BurstStrength;
    attributes.scaleZ=BurstStrength;\n attributes.angleZ=(r-0.5)*0.5; attributes.texIndex=floor(q*4.0);\n
    attributes.color=lerp(float3(0.91,0.85,0.72),float3(0.85,0.78,0.64),r);\n attributes.alpha=0.0;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: DustBirth
    selectedIndex: 0
